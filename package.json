{
  "name": "naheulboard",
  "private": true,
  "version": "0.1.0",
  "description": "Soundboard pour Le Donjon de Naheulbeuk : musiques, ambiances et sons superposables.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sounds:placeholders": "node scripts/generate-placeholder-sounds.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
